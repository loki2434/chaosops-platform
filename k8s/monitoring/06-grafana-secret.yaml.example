# DO NOT commit this file with a real password filled in.
# Generate and apply it directly instead:
#
#   kubectl create secret generic grafana-admin \
#     --namespace monitoring \
#     --from-literal=admin-password='<pick-a-real-password>'
#
# This file is here only as a reference for the Secret's shape/name that
# 07-grafana-deployment.yaml expects.

apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: monitoring
type: Opaque
stringData:
  admin-password: CHANGE_ME
